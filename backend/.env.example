# ─────────────────────────────────────────────────────────────
# Dadi Mulyo Backend — contoh environment
# Salin jadi .env:  cp .env.example .env
# Nilai di bawah disetel untuk LOCAL DEVELOPMENT (Laragon).
# Catatan production ada di bagian bawah file (jangan aktifkan di lokal).
# ─────────────────────────────────────────────────────────────

APP_NAME="Dadi Mulyo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dadimulyo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Midtrans ─────────────────────────────────────────────────
# Ambil dari Dashboard Midtrans > Settings > Access Keys.
# Untuk pengujian pakai key Sandbox (awalan SB-Mid-...) dan
# MIDTRANS_IS_PRODUCTION=false.
#
# Server key ini juga dipakai memverifikasi signature_key pada
# webhook /api/midtrans/payment-notification — wajib terisi di
# production agar notifikasi pembayaran tidak ditolak.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ─── OTP email (login/registrasi) ─────────────────────────────
# false  = lokal tanpa mail server: langsung login tanpa OTP.
# true   = production: wajib mail server berfungsi, jika tidak login gagal.
AUTH_OTP_REQUIRED=false
AUTH_OTP_EXPIRY_MINUTES=10

# ─── Firebase Cloud Messaging (push notification mobile) ─────
# 1. Firebase Console > Project settings > Service accounts
# 2. Generate new private key, simpan mis. storage/firebase-service-account.json
# 3. Isi FIREBASE_PROJECT_ID sesuai project. Jika kosong, notifikasi tetap
#    tersimpan di DB tanpa push.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# ─── Sanctum ──────────────────────────────────────────────────
# Domain frontend yang boleh auth SPA; produksi: dadimulyo.my.id
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Expiry token (menit). null = tidak pernah expire. Disarankan 1440 (24 jam).
SANCTUM_TOKEN_EXPIRATION=1440

# Rate limiting: requests per menit untuk login/register
API_RATE_LIMIT=60

# URL frontend (dipakai CORS & redirect)
FRONTEND_URL=http://localhost:5173

# ─── Seeder Demo Data (opsional) ──────────────────────────────
# Isi hanya jika ingin mengganti data demo default saat migration.
DEMO_ADMIN_EMAIL=admin@dadimulyo.my.id
DEMO_SALES_EMAIL=sales@dadimulyo.my.id
DEMO_SELLER_EMAIL=seller@dadimulyo.my.id
DEMO_ORANGE_SELLER_EMAIL=orangeseller@dadimulyo.my.id
DEMO_CUSTOMER_EMAIL=customer@dadimulyo.my.id
DEMO_DEFAULT_PASSWORD=password
DEMO_DEFAULT_PHONE=081234567890
DEMO_PHONE_SALES=081234567811
DEMO_PHONE_SELLER_TRUCK=081234567822
DEMO_PHONE_SELLER_ORANGE=081234567833
DEMO_PHONE_CUSTOMER=081234567844

# ─────────────────────────────────────────────────────────────
# CATATAN PRODUCTION (dadimulyo.my.id) — ubah nilai berikut saat deploy:
#
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://dadimulyo.my.id
#   SESSION_DOMAIN=dadimulyo.my.id
#   SANCTUM_STATEFUL_DOMAINS=dadimulyo.my.id
#   FRONTEND_URL=https://dadimulyo.my.id
#   MIDTRANS_SERVER_KEY=Mid-server-...        (key production, bukan SB-)
#   MIDTRANS_CLIENT_KEY=Mid-client-...
#   MIDTRANS_IS_PRODUCTION=true
#   AUTH_OTP_REQUIRED=true
#   MAIL_*  -> kredensial SMTP asli
# ─────────────────────────────────────────────────────────────
